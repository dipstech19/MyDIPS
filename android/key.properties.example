# Copy this file to "key.properties" in the same folder (android/) and fill real values.
# Never commit key.properties or *.jks / *.keystore.
#
# Create a release keystore once (from repo root or android/):
#   keytool -genkey -v -keystore android/keystore/dips-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias dips
#
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=dips
storeFile=keystore/dips-release.jks
